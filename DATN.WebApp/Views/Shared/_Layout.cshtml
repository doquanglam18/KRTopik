    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Initialize chat box after all scripts are loaded -->
    <script>
        $(document).ready(function() {
            const chatBox = {
                init: function() {
                    console.log("Initializing chat box");
                    this.elements = {
                        toggle: $('#chat-toggle'),
                        box: $('#chat-box'),
                        messages: $('#chat-messages'),
                        form: $('#chat-form'),
                        input: $('#chat-input'),
                        minimize: $('#chat-minimize')
                    };

                    // Check if all elements exist
                    Object.entries(this.elements).forEach(([key, element]) => {
                        console.log(`Checking ${key}:`, element.length > 0);
                    });

                    if (!this.elements.toggle.length || !this.elements.box.length || 
                        !this.elements.messages.length || !this.elements.form.length || 
                        !this.elements.input.length || !this.elements.minimize.length) {
                        console.error("Some chat elements are missing");
                        return;
                    }

                    this.setupEventListeners();
                    this.loadVisibilityState();
                    console.log("Chat box initialization complete");
                },

                setupEventListeners: function() {
                    console.log("Setting up event listeners");
                    
                    // Toggle chat visibility
                    this.elements.toggle.on('click', () => {
                        console.log("Toggle clicked");
                        this.toggleChat(true);
                        // Add system message if it's the first time opening chat
                        if (this.elements.messages.children().length === 0) {
                            this.addSystemMessage();
                        }
                    });

                    // Minimize chat
                    this.elements.minimize.on('click', () => {
                        console.log("Minimize clicked");
                        this.toggleChat(false);
                    });

                    // Handle form submission
                    this.elements.form.on('submit', (e) => {
                        e.preventDefault();
                        console.log("Form submitted");
                        this.handleSubmit();
                    });

                    // Handle input changes
                    this.elements.input.on('input', () => {
                        console.log("Input changed");
                        this.elements.input.css('height', 'auto');
                        this.elements.input.css('height', this.elements.input[0].scrollHeight + 'px');
                    });
                },

                loadVisibilityState: async function() {
                    try {
                        const response = await fetch('/api/GeminiApi/visibility');
                        const data = await response.json();
                        if (data.success) {
                            this.toggleChat(data.isVisible);
                        }
                    } catch (error) {
                        console.error('Error loading visibility state:', error);
                    }
                },

                toggleChat: async function(show) {
                    console.log("Toggling chat visibility:", show);
                    if (show) {
                        this.elements.toggle.hide();
                        this.elements.box.show();
                    } else {
                        this.elements.box.hide();
                        this.elements.toggle.show();
                    }

                    // Save visibility state
                    try {
                        await fetch('/api/GeminiApi/toggle-visibility', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ isVisible: show })
                        });
                    } catch (error) {
                        console.error('Error saving visibility state:', error);
                    }
                },

                handleSubmit: async function() {
                    const message = this.elements.input.val().trim();
                    if (!message) return;

                    try {
                        // Disable input while processing
                        this.elements.input.prop('disabled', true);
                        
                        // Add user message
                        this.addMessage('user', message);
                        this.elements.input.val('').css('height', 'auto');
                        
                        // Show typing indicator
                        this.showTypingIndicator();
                        
                        // Add context to the message
                        const contextMessage = `Bạn là một trợ lý AI chuyên về tiếng Hàn và văn hóa Hàn Quốc. 
                        Hãy trả lời câu hỏi sau đây một cách chuyên nghiệp và hữu ích. 
                        Nếu câu hỏi không liên quan đến tiếng Hàn, văn hóa Hàn Quốc, hoặc việc học ngôn ngữ, 
                        hãy nhẹ nhàng đề nghị người dùng đặt câu hỏi liên quan đến chủ đề này.
                        
                        Câu hỏi của người dùng: ${message}`;
                        
                        // Send message to API
                        const response = await this.sendMessage(contextMessage);
                        
                        // Remove typing indicator
                        this.hideTypingIndicator();

                        // Check if the response indicates out of scope
                        if (response.toLowerCase().includes("không liên quan") || 
                            response.toLowerCase().includes("không phải chủ đề")) {
                            this.addOutOfScopeMessage();
                        }
                        
                        // Add response
                        this.addMessage('assistant', response);
                    } catch (error) {
                        console.error('Error in handleSubmit:', error);
                        this.hideTypingIndicator();
                        this.addMessage('error', 'Xin lỗi, đã có lỗi xảy ra. Vui lòng thử lại sau.');
                    } finally {
                        this.elements.input.prop('disabled', false).focus();
                    }
                },

                sendMessage: async function(message) {
                    console.log("Sending message:", message);
                    try {
                        const requestBody = { prompt: message };
                        console.log("Request body:", JSON.stringify(requestBody));

                        const response = await fetch('https://localhost:7208/api/GeminiApi/ask', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify(requestBody)
                        });

                        const responseText = await response.text();
                        console.log("Response status:", response.status);
                        console.log("Response headers:", Object.fromEntries(response.headers.entries()));
                        console.log("Response body:", responseText);

                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}, body: ${responseText}`);
                        }

                        let data;
                        try {
                            data = JSON.parse(responseText);
                        } catch (e) {
                            console.error("Error parsing response as JSON:", e);
                            throw new Error("Invalid JSON response from server");
                        }

                        console.log("Parsed API Response:", data);
                        
                        if (!data.success) {
                            throw new Error(data.message || 'Unknown error occurred');
                        }

                        return data.message;
                    } catch (error) {
                        console.error('Error in sendMessage:', error);
                        console.error('Error stack:', error.stack);
                        throw error;
                    }
                },

                addMessage: function(role, text) {
                    const isUser = role === 'user';
                    const avatar = isUser ? 
                        '<i class="fas fa-user"></i>' : 
                        '<i class="fas fa-robot"></i>';
                    const sender = isUser ? 'Bạn' : 'Chat Oppa';
                    
                    const messageHtml = `
                        <div class="chat-message ${role}">
                            <div class="message-header">
                                <div class="message-avatar">
                                    ${avatar}
                                </div>
                                <div class="message-sender">${sender}</div>
                            </div>
                            <div class="message-content">
                                ${this.formatMessage(text)}
                            </div>
                        </div>
                    `;
                    this.elements.messages.append(messageHtml);
                    this.scrollToBottom();
                },

                showTypingIndicator: function() {
                    const indicator = `
                        <div class="chat-message assistant-message typing-indicator">
                            <div class="message-content">
                                <div class="typing-indicator">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </div>
                            </div>
                        </div>
                    `;
                    this.elements.messages.append(indicator);
                    this.scrollToBottom();
                },

                hideTypingIndicator: function() {
                    this.elements.messages.find('.typing-indicator').remove();
                },

                formatMessage: function(text) {
                    // Convert URLs to clickable links
                    const urlRegex = /(https?:\/\/[^\s]+)/g;
                    return text.replace(urlRegex, url => `<a href="${url}" target="_blank">${url}</a>`)
                        // Convert newlines to <br>
                        .replace(/\n/g, '<br>');
                },

                scrollToBottom: function() {
                    const messages = this.elements.messages[0];
                    messages.scrollTop = messages.scrollHeight;
                },

                addSystemMessage: function() {
                    const systemMessage = `
                        <div class="chat-message system">
                            <i class="fas fa-info-circle system-message-icon"></i>
                            Xin chào! Tôi là trợ lý AI chuyên về tiếng Hàn và văn hóa Hàn Quốc. 
                            Tôi có thể giúp bạn với:
                            <br>• Học tiếng Hàn (ngữ pháp, từ vựng, phát âm)
                            <br>• Luyện thi TOPIK
                            <br>• Tìm hiểu văn hóa Hàn Quốc
                            <br>• Giải đáp thắc mắc về Hàn Quốc
                            <br><br>
                            Hãy đặt câu hỏi và tôi sẽ cố gắng hỗ trợ bạn tốt nhất!
                        </div>
                    `;
                    this.elements.messages.append(systemMessage);
                    this.scrollToBottom();
                },

                addOutOfScopeMessage: function() {
                    const outOfScopeMessage = `
                        <div class="chat-message out-of-scope">
                            <i class="fas fa-exclamation-circle out-of-scope-icon"></i>
                            Tôi là trợ lý chuyên về tiếng Hàn và văn hóa Hàn Quốc. 
                            Bạn có thể hỏi tôi về:
                            <br>• Học tiếng Hàn
                            <br>• Luyện thi TOPIK
                            <br>• Văn hóa Hàn Quốc
                            <br>• Thông tin về Hàn Quốc
                        </div>
                    `;
                    this.elements.messages.append(outOfScopeMessage);
                    this.scrollToBottom();
                }
            };

            // Initialize chat box
            chatBox.init();
        });
    </script>

    <script>
        $(document).ready(function () {
            $('#btnLogout').click(function (e) {
                e.preventDefault();

                Swal.fire({
                    title: 'Xác nhận',
                    text: 'Bạn có chắc chắn muốn đăng xuất không?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đăng xuất',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#logoutForm').submit(); // Gửi request POST
                    }
                });
            });
        });
    </script>

    <script>
        document.getElementById('btnLogout').addEventListener('click', function (e) {
            e.preventDefault();

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('@Url.Action("LogOut", "User")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({})
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Đăng xuất thành công',
                            text: data.message,
                            confirmButtonText: 'OK'
                        }).then(() => {
                            window.location.href = data.redirectUrl;
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: data.message
                        });
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Không thể kết nối đến máy chủ!'
                    });
                });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>