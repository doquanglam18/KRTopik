    <style>
        .chat-toggle {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: linear-gradient(135deg, #4CAF50, #45a049);
            color: white;
            border-radius: 50%;
            width: 70px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 1000;
            box-shadow: 0 6px 20px rgba(0,0,0,0.25);
            transition: all 0.3s ease;
            border: 3px solid white;
        }

        .chat-toggle:hover {
            transform: scale(1.15) rotate(5deg);
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
            background: linear-gradient(135deg, #45a049, #388e3c);
        }

        .chat-toggle:active {
            transform: scale(0.95);
        }

        .chat-toggle i {
            font-size: 2rem;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
        }

        .chat-box {
            position: fixed;
            bottom: 110px;
            right: 30px;
            width: 380px;
            height: 600px;
            background-color: #f8f9fa;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.2);
            display: none;
            z-index: 999;
            flex-direction: column;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin-top: 80px;
            max-height: calc(100vh - 200px);
        }

        .chat-header {
            padding: 15px 20px;
            background: linear-gradient(135deg, #4CAF50, #45a049);
            color: white;
            border-radius: 15px 15px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .chat-title {
            font-weight: 600;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .chat-title i {
            font-size: 1.3rem;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            height: calc(100% - 140px);
            background-color: #f8f9fa;
        }

        .chat-message {
            max-width: 85%;
            padding: 12px 16px;
            border-radius: 18px;
            position: relative;
            word-wrap: break-word;
            animation: messageAppear 0.3s ease-out;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        @@keyframes messageAppear {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .chat-message.user {
            align-self: flex-end;
            background: linear-gradient(135deg, #4CAF50, #45a049);
            color: white;
            border-bottom-right-radius: 5px;
            margin-left: 40px;
        }

        .chat-message.assistant {
            align-self: flex-start;
            background-color: white;
            color: #333;
            border-bottom-left-radius: 5px;
            margin-right: 40px;
            border: 1px solid #e0e0e0;
        }

        .chat-message.error {
            align-self: center;
            background-color: #ffebee;
            color: #c62828;
            border-radius: 10px;
            text-align: center;
            font-size: 0.9rem;
            padding: 10px 15px;
            margin: 10px 0;
            border: 1px solid #ffcdd2;
        }

        .message-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }

        .message-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: white;
        }

        .user .message-avatar {
            background: #45a049;
        }

        .assistant .message-avatar {
            background: #2196F3;
        }

        .message-sender {
            font-weight: 600;
            font-size: 0.9rem;
        }

        .user .message-sender {
            color: #e8f5e9;
        }

        .assistant .message-sender {
            color: #666;
        }

        .message-content {
            line-height: 1.5;
            font-size: 0.95rem;
        }

        .user .message-content {
            color: white;
        }

        .assistant .message-content {
            color: #333;
        }

        .chat-input-container {
            padding: 15px 20px;
            background-color: white;
            border-top: 1px solid #e0e0e0;
            border-radius: 0 0 15px 15px;
        }

        .chat-form .input-group {
            background-color: #f8f9fa;
            border-radius: 25px;
            padding: 5px;
            border: 1px solid #e0e0e0;
            transition: all 0.3s ease;
        }

        .chat-form .input-group:focus-within {
            box-shadow: 0 0 0 2px rgba(76, 175, 80, 0.2);
            border-color: #4CAF50;
        }

        .chat-form .form-control {
            border: none;
            background: none;
            padding: 10px 15px;
            font-size: 0.95rem;
        }

        .chat-form .form-control:focus {
            box-shadow: none;
        }

        .chat-form .btn {
            border-radius: 50%;
            width: 40px;
            height: 40px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #4CAF50, #45a049);
            border: none;
            transition: all 0.3s ease;
        }

        .chat-form .btn:hover {
            transform: scale(1.05);
            background: linear-gradient(135deg, #45a049, #388e3c);
        }

        .chat-form .btn i {
            font-size: 1rem;
            color: white;
        }

        .typing-indicator {
            display: none;
            padding: 12px 16px;
            background-color: white;
            border-radius: 18px;
            align-self: flex-start;
            margin-bottom: 10px;
            border: 1px solid #e0e0e0;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        .typing-indicator span {
            display: inline-block;
            width: 8px;
            height: 8px;
            background-color: #4CAF50;
            border-radius: 50%;
            margin: 0 2px;
            animation: typing 1s infinite;
        }

        @@keyframes typing {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }

        .scroll-to-bottom {
            position: absolute;
            bottom: 80px;
            right: 30px;
            background-color: #4CAF50;
            color: white;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            transition: opacity 0.3s ease;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .scroll-to-bottom.visible {
            opacity: 1;
        }

        /* Add new styles for system message */
        .chat-message.system {
            align-self: center;
            background-color: #e3f2fd;
            color: #1565c0;
            border-radius: 10px;
            text-align: center;
            font-size: 0.9rem;
            padding: 12px 20px;
            margin: 10px 0;
            border: 1px solid #bbdefb;
            max-width: 90%;
        }

        .system-message-icon {
            color: #1565c0;
            margin-right: 8px;
        }

        .chat-message.out-of-scope {
            align-self: center;
            background-color: #fff3e0;
            color: #e65100;
            border-radius: 10px;
            text-align: center;
            font-size: 0.9rem;
            padding: 12px 20px;
            margin: 10px 0;
            border: 1px solid #ffe0b2;
            max-width: 90%;
        }

        .out-of-scope-icon {
            color: #e65100;
            margin-right: 8px;
        }

        /* Add media query for smaller screens */
        @@media (max-height: 800px) {
            .chat-box {
                height: 600px;
                margin-top: 40px;
            }
        }

        /* New Navbar Styles */
        .navbar {
            padding: 1rem 0;
        }

        .navbar-brand {
            font-size: 1.8rem;
            font-weight: 700;
            padding: 0.5rem 1rem;
        }

        .navbar-brand span {
            color: #ff6b6b;
        }

        .navbar-nav {
            gap: 0.5rem;
        }

        .nav-item {
            margin: 0 0.3rem;
        }

        .nav-link {
            font-size: 1.1rem;
            font-weight: 500;
            padding: 0.7rem 1.2rem !important;
            color: #fff !important;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

        .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
        }

        .nav-item.active .nav-link {
            background-color: rgba(255, 255, 255, 0.2);
            font-weight: 600;
        }

        /* Style for user dropdown */
        .nav-item.dropdown .nav-link {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-item.dropdown .nav-link img {
            width: 35px;
            height: 35px;
            border: 2px solid rgba(255, 255, 255, 0.8);
        }

        .dropdown-menu {
            border: none;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            border-radius: 0.5rem;
            padding: 0.5rem;
        }

        .dropdown-item {
            padding: 0.7rem 1rem;
            font-size: 1rem;
            border-radius: 0.4rem;
            transition: all 0.2s ease;
        }

        .dropdown-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }

        .dropdown-item.text-danger:hover {
            background-color: #dc3545;
            color: white !important;
        }

        /* Responsive adjustments */
        @@media (max-width: 991.98px) {
            .navbar-collapse {
                background-color: rgba(0, 0, 0, 0.95);
                padding: 1rem;
                border-radius: 0.5rem;
                margin-top: 1rem;
            }

            .nav-item {
                margin: 0.3rem 0;
            }

            .nav-link {
                padding: 0.8rem 1rem !important;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
