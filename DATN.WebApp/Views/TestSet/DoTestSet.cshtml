@using DATN.Application.Dtos.TestSetDtos
@using DATN.Application.Dtos.ListeningDtos
@using DATN.Application.Dtos.ReadingDtos
@model DoTestSetDto

@{
    ViewData["Title"] = "Làm đề thi";
    var isListening = Model.listeningQuestions != null && Model.listeningQuestions.Any();
    var questions = isListening ? Model.listeningQuestions.Cast<object>().ToList() : Model.readingQuestions.Cast<object>().ToList();
    int totalTimeInSeconds = ViewData["TimeLimit"] != null ? Convert.ToInt32(ViewData["TimeLimit"]) * 60 : 0;

    if (totalTimeInSeconds == 0)
    {
        totalTimeInSeconds = isListening
            ? (questions.Count * 30) + 10
            : (int)(questions.Count * 1.4 * 60);
    }

    Layout = null;
    var userName = ViewData["UserName"] as string ?? "Khách";
    var userAvatar = ViewData["UserAvatar"] as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- jQuery CDN -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Custom Styles -->
    <style>
        :root {
            --primary: #4F46E5;
            --primary-light: #6366F1;
            --primary-dark: #4338CA;
            --secondary: #10B981;
            --danger: #EF4444;
            --warning: #F59E0B;
            --info: #3B82F6;
            --light: #F9FAFB;
            --dark: #1F2937;
            --gray: #6B7280;
            --gray-light: #E5E7EB;
            --text-primary: #111827;
            --text-secondary: #4B5563;
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            --rounded-sm: 0.25rem;
            --rounded: 0.5rem;
            --rounded-lg: 0.75rem;
            --rounded-xl: 1rem;
            --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #F3F4F6;
            color: var(--text-primary);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 960px;
            padding-top: 2rem;
            padding-bottom: 4rem;
        }

        /* Header Card */
        .header-card {
            background: white;
            border-radius: var(--rounded-xl);
            box-shadow: var(--shadow);
            padding: 2rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            border-left: 6px solid var(--primary);
        }

            .header-card::before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 30%;
                height: 100%;
                background: linear-gradient(135deg, rgba(79, 70, 229, 0.1) 0%, rgba(99, 102, 241, 0.05) 100%);
                z-index: 0;
            }

        .test-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 0.5rem;
            position: relative;
        }

        .test-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .badge {
            font-weight: 500;
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
        }

        .badge-primary {
            background-color: var(--primary);
        }

        .badge-success {
            background-color: var(--secondary);
        }

        .badge-warning {
            background-color: var(--warning);
        }

        .badge-info {
            background-color: var(--info);
        }

        /* Countdown */
        #countdown {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background-color: var(--primary);
            color: white;
            padding: 0.5rem 1.25rem;
            border-radius: 50px;
            font-weight: 600;
            box-shadow: var(--shadow-sm);
            position: relative;
            z-index: 1;
        }

        /* User Info */
        .user-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: white;
            padding: 0.5rem 1rem 0.5rem 0.5rem;
            border-radius: 50px;
            box-shadow: var(--shadow-sm);
            position: relative;
            z-index: 1;
        }

        .avatar {
            width: 36px;
            height: 36px;
            object-fit: cover;
            border-radius: 50%;
            border: 2px solid white;
        }

        .user-name {
            font-weight: 600;
            color: var(--dark);
            font-size: 0.9rem;
        }

        /* Question Card */
        .question-card {
            background: white;
            border-radius: var(--rounded-lg);
            box-shadow: var(--shadow-sm);
            margin-bottom: 1.5rem;
            overflow: hidden;
            transition: var(--transition);
            border: 1px solid var(--gray-light);
        }

            .question-card:hover {
                box-shadow: var(--shadow);
                transform: translateY(-2px);
            }

        .question-header {
            background-color: var(--primary);
            color: white;
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .question-number {
            font-weight: 600;
            font-size: 1rem;
        }

        .question-content {
            padding: 1.5rem;
            color: var(--text-primary);
            font-size: 1.05rem;
            line-height: 1.7;
        }

        .question-image {
            max-width: 100%;
            height: auto;
            border-radius: var(--rounded);
            margin: 1rem 0;
            box-shadow: var(--shadow-sm);
        }

        /* Answer Options */
        .answers-container {
            margin-top: 1rem;
        }

        .answer-option {
            padding: 1rem;
            margin-bottom: 0.75rem;
            border-radius: var(--rounded);
            background-color: var(--light);
            transition: var(--transition);
            cursor: pointer;
            border: 1px solid transparent;
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }

            .answer-option:hover {
                background-color: #EDE9FE;
                border-color: var(--primary-light);
            }

            .answer-option.selected {
                background-color: #EDE9FE;
                border-left: 4px solid var(--primary);
            }

            .answer-option .form-check-input {
                margin-top: 0.25rem;
                flex-shrink: 0;
            }

            .answer-option .form-check-label {
                cursor: pointer;
                width: 100%;
            }

        .answer-image {
            max-width: 100%;
            height: auto;
            border-radius: var(--rounded-sm);
            margin-top: 0.5rem;
            border: 1px solid var(--gray-light);
        }

        /* Audio Player */
        .audio-player {
            width: 100%;
            margin: 1.5rem 0;
            border-radius: var(--rounded);
        }

        /* Submit Button */
        .btn-submit {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 1rem 2.5rem;
            font-weight: 600;
            border-radius: 50px;
            transition: var(--transition);
            box-shadow: var(--shadow);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 2rem;
        }

            .btn-submit:hover {
                background-color: var(--primary-dark);
                transform: translateY(-2px);
                box-shadow: var(--shadow-md);
            }

        /* Progress Bar */
        .progress-container {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: var(--gray-light);
            z-index: 1000;
        }

        .progress-bar {
            height: 100%;
            background: var(--primary);
            width: 0;
            transition: width 0.3s ease;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .header-card {
                flex-direction: column;
                gap: 1.5rem;
            }

                .header-card::before {
                    width: 100%;
                    height: 30%;
                    bottom: 0;
                    top: auto;
                }

            .test-title {
                font-size: 1.5rem;
            }

            .question-content {
                padding: 1.25rem;
            }
        }

        /* Animation */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .question-card {
            animation: fadeIn 0.3s ease forwards;
        }

            .question-card:nth-child(odd) {
                animation-delay: 0.05s;
            }

            .question-card:nth-child(even) {
                animation-delay: 0.1s;
            }


        .chat-toggle {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: linear-gradient(135deg, #4CAF50, #45a049);
            color: white;
            border-radius: 50%;
            width: 70px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 1000;
            box-shadow: 0 6px 20px rgba(0,0,0,0.25);
            transition: all 0.3s ease;
            border: 3px solid white;
        }

            .chat-toggle:hover {
                transform: scale(1.15) rotate(5deg);
                box-shadow: 0 8px 25px rgba(0,0,0,0.3);
                background: linear-gradient(135deg, #45a049, #388e3c);
            }

            .chat-toggle:active {
                transform: scale(0.95);
            }

            .chat-toggle i {
                font-size: 2rem;
                text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
            }

        .chat-box {
            position: fixed;
            bottom: 110px;
            right: 30px;
            width: 380px;
            height: 600px;
            background-color: #f8f9fa;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.2);
            display: none;
            z-index: 999;
            flex-direction: column;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin-top: 80px;
            max-height: calc(100vh - 200px);
        }

        .chat-header {
            padding: 15px 20px;
            background: linear-gradient(135deg, #4CAF50, #45a049);
            color: white;
            border-radius: 15px 15px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .chat-title {
            font-weight: 600;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .chat-title i {
                font-size: 1.3rem;
            }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            height: calc(100% - 140px);
            background-color: #f8f9fa;
        }

        .chat-message {
            max-width: 85%;
            padding: 12px 16px;
            border-radius: 18px;
            position: relative;
            word-wrap: break-word;
            animation: messageAppear 0.3s ease-out;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        @@keyframes messageAppear {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .chat-message.user {
            align-self: flex-end;
            background: linear-gradient(135deg, #4CAF50, #45a049);
            color: white;
            border-bottom-right-radius: 5px;
            margin-left: 40px;
        }

        .chat-message.assistant {
            align-self: flex-start;
            background-color: white;
            color: #333;
            border-bottom-left-radius: 5px;
            margin-right: 40px;
            border: 1px solid #e0e0e0;
        }

        .chat-message.error {
            align-self: center;
            background-color: #ffebee;
            color: #c62828;
            border-radius: 10px;
            text-align: center;
            font-size: 0.9rem;
            padding: 10px 15px;
            margin: 10px 0;
            border: 1px solid #ffcdd2;
        }

        .message-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }

        .message-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: white;
        }

        .user .message-avatar {
            background: #45a049;
        }

        .assistant .message-avatar {
            background: #2196F3;
        }

        .message-sender {
            font-weight: 600;
            font-size: 0.9rem;
        }

        .user .message-sender {
            color: #e8f5e9;
        }

        .assistant .message-sender {
            color: #666;
        }

        .message-content {
            line-height: 1.5;
            font-size: 0.95rem;
        }

        .user .message-content {
            color: white;
        }

        .assistant .message-content {
            color: #333;
        }

        .chat-input-container {
            padding: 15px 20px;
            background-color: white;
            border-top: 1px solid #e0e0e0;
            border-radius: 0 0 15px 15px;
        }

        .chat-form .input-group {
            background-color: #f8f9fa;
            border-radius: 25px;
            padding: 5px;
            border: 1px solid #e0e0e0;
            transition: all 0.3s ease;
        }

            .chat-form .input-group:focus-within {
                box-shadow: 0 0 0 2px rgba(76, 175, 80, 0.2);
                border-color: #4CAF50;
            }

        .chat-form .form-control {
            border: none;
            background: none;
            padding: 10px 15px;
            font-size: 0.95rem;
        }

            .chat-form .form-control:focus {
                box-shadow: none;
            }

        .chat-form .btn {
            border-radius: 50%;
            width: 40px;
            height: 40px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #4CAF50, #45a049);
            border: none;
            transition: all 0.3s ease;
        }

            .chat-form .btn:hover {
                transform: scale(1.05);
                background: linear-gradient(135deg, #45a049, #388e3c);
            }

            .chat-form .btn i {
                font-size: 1rem;
                color: white;
            }

        .typing-indicator {
            display: none;
            padding: 12px 16px;
            background-color: white;
            border-radius: 18px;
            align-self: flex-start;
            margin-bottom: 10px;
            border: 1px solid #e0e0e0;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

            .typing-indicator span {
                display: inline-block;
                width: 8px;
                height: 8px;
                background-color: #4CAF50;
                border-radius: 50%;
                margin: 0 2px;
                animation: typing 1s infinite;
            }

        @@keyframes typing {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-5px);
            }
        }

        .scroll-to-bottom {
            position: absolute;
            bottom: 80px;
            right: 30px;
            background-color: #4CAF50;
            color: white;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            transition: opacity 0.3s ease;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

            .scroll-to-bottom.visible {
                opacity: 1;
            }

        /* Add new styles for system message */
        .chat-message.system {
            align-self: center;
            background-color: #e3f2fd;
            color: #1565c0;
            border-radius: 10px;
            text-align: center;
            font-size: 0.9rem;
            padding: 12px 20px;
            margin: 10px 0;
            border: 1px solid #bbdefb;
            max-width: 90%;
        }

        .system-message-icon {
            color: #1565c0;
            margin-right: 8px;
        }

        .chat-message.out-of-scope {
            align-self: center;
            background-color: #fff3e0;
            color: #e65100;
            border-radius: 10px;
            text-align: center;
            font-size: 0.9rem;
            padding: 12px 20px;
            margin: 10px 0;
            border: 1px solid #ffe0b2;
            max-width: 90%;
        }

        .out-of-scope-icon {
            color: #e65100;
            margin-right: 8px;
        }

        /* Add media query for smaller screens */
        @@media (max-height: 800px) {
            .chat-box {
                height: 600px;
                margin-top: 40px;
            }
        }

        }
    </style>
</head>
<body>
    <!-- Progress Bar -->
    <div class="progress-container">
        <div class="progress-bar" id="progressBar"></div>
    </div>

    <div class="container">
        <!-- Header -->
        <div class="header-card d-flex flex-column flex-md-row justify-content-between gap-4">
            <div class="header-content">
                <h1 class="test-title">@Model.TestName</h1>
                <div class="test-meta">
                    <div class="meta-item">
                        <i class="bi bi-calendar-check"></i>
                        <span>@Model.CreatedDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="meta-item">
                        <i class="bi bi-speedometer2"></i>
                        <span class="badge badge-primary">@Model.RankQuestionName</span>
                    </div>
                    <div class="meta-item">
                        <i class="bi bi-star-fill"></i>
                        <span class="badge badge-warning">@Model.AvgRating.ToString("0.0")</span>
                    </div>
                    <div class="meta-item">
                        <i class="bi bi-question-circle"></i>
                        <span class="badge badge-info">@questions.Count câu</span>
                    </div>
                </div>
            </div>
            <div class="header-actions d-flex flex-column align-items-end gap-3">
                <span id="countdown">
                    <i class="bi bi-clock"></i>
                    <span>Đang tính thời gian...</span>
                </span>
                <div class="user-info">
                    @if (!string.IsNullOrEmpty(userAvatar))
                    {
                        <img src="@userAvatar" alt="Avatar" class="avatar" />
                    }
                    <span class="user-name">@userName</span>
                </div>
            </div>
        </div>

        <!-- Form -->
        <form method="post" asp-action="SubmitTest" asp-controller="TestSet" id="examForm">
            <input type="hidden" name="TestSetId" value="@Model.Id" />
            <input type="hidden" name="FirstAttemptAt" id="startTime" />
            <input type="hidden" name="LastAttemptAt" id="endTime" />

            @for (int i = 0; i < questions.Count; i++)
            {
                <div class="question-card" style="animation-delay: @(i * 0.05)">
                    <div class="question-header">
                        <i class="bi bi-question-circle-fill"></i>
                        <span class="question-number">Câu hỏi @(i + 1)</span>
                    </div>
                    <div class="question-content">
                        @if (isListening)
                        {
                            var q = (ListeningQuestionForTestDto)questions[i];
                            <div>@Html.Raw(q.Question)</div>
                            <audio controls class="audio-player">
                                <source src="@q.ListeningSoundURL" type="audio/mpeg" />
                                Trình duyệt không hỗ trợ audio.
                            </audio>
                            <div class="answers-container row g-3">
                                @for (int j = 0; j < q.ListeningAnswers.Count; j++)
                                {
                                    var ans = q.ListeningAnswers[j];
                                    bool isImage = !string.IsNullOrEmpty(ans.Content) &&
                                    (ans.Content.StartsWith("http") && (
                                    ans.Content.EndsWith(".jpg") ||
                                    ans.Content.EndsWith(".jpeg") ||
                                    ans.Content.EndsWith(".png") ||
                                    ans.Content.Contains("cloudinary.com")
                                    ));

                                    <div class="@(isImage ? "col-md-6" : "col-12")">
                                        <div class="answer-option">
                                            <input class="form-check-input" type="radio" name="Answers[@i].SelectedAnswerId" value="@ans.Id" id="listen_@ans.Id" />
                                            <label class="form-check-label" for="listen_@ans.Id">
                                                @if (isImage)
                                                {
                                                    <img src="@ans.Content" alt="Đáp án dạng ảnh" class="answer-image" />
                                                }
                                                else
                                                {
                                                    @ans.Content
                                                }
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            var q = (ReadingQuestionForTestDto)questions[i];
                            <div>@Html.Raw(q.Question)</div>
                            @if (!string.IsNullOrEmpty(q.ReadingImageURL))
                            {
                                <img src="@q.ReadingImageURL" class="question-image" alt="Reading Image" />
                            }
                            <div class="answers-container">
                                @foreach (var ans in q.ReadingAnswers)
                                {
                                    <div class="answer-option">
                                        <input class="form-check-input" type="radio" name="Answers[@i].SelectedAnswerId" value="@ans.Id" id="read_@ans.Id" />
                                        <label class="form-check-label" for="read_@ans.Id">@ans.Content</label>
                                    </div>
                                }
                            </div>
                        }

                        <input type="hidden" name="Answers[@i].QuestionId" value="@(isListening ? ((ListeningQuestionForTestDto)questions[i]).Id : ((ReadingQuestionForTestDto)questions[i]).Id)" />
                    </div>
                </div>
            }

            <div class="text-center">
                <button type="button" id="submitBtn" class="btn btn-submit">
                    <i class="bi bi-send-check"></i> Nộp bài
                </button>
            </div>
        </form>
    </div>


    <!-- Chat bubble button -->
    <div id="chat-toggle" class="chat-toggle">
        <i class="fas fa-comments"></i>
    </div>

    <!-- Chat window -->
    <div id="chat-box" class="chat-box">
        <div class="chat-header">
            <span class="chat-title">
                <i class="fas fa-robot me-2"></i>Chat Bot
            </span>
            <button id="chat-minimize" class="btn-minimize">
                <i class="fas fa-minus"></i>
            </button>
        </div>
        <div id="chat-messages" class="chat-messages">
            <!-- Messages will appear here -->
        </div>
        <div class="chat-input-container">
            <form id="chat-form" class="chat-form">
                <div class="input-group">
                    <input type="text"
                           id="chat-input"
                           class="form-control"
                           placeholder="Type your message..."
                           maxlength="1000"
                           autocomplete="off" />
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>




    <!-- Initialize chat box after all scripts are loaded -->
    <script>
        $(document).ready(function () {
            const chatBox = {
                init: function () {
                    console.log("Initializing chat box");
                    this.elements = {
                        toggle: $('#chat-toggle'),
                        box: $('#chat-box'),
                        messages: $('#chat-messages'),
                        form: $('#chat-form'),
                        input: $('#chat-input'),
                        minimize: $('#chat-minimize')
                    };

                    // Check if all elements exist
                    Object.entries(this.elements).forEach(([key, element]) => {
                        console.log(`Checking ${key}:`, element.length > 0);
                    });

                    if (!this.elements.toggle.length || !this.elements.box.length ||
                        !this.elements.messages.length || !this.elements.form.length ||
                        !this.elements.input.length || !this.elements.minimize.length) {
                        console.error("Some chat elements are missing");
                        return;
                    }

                    this.setupEventListeners();
                    this.loadVisibilityState();
                    console.log("Chat box initialization complete");
                },

                setupEventListeners: function () {
                    console.log("Setting up event listeners");

                    // Toggle chat visibility
                    this.elements.toggle.on('click', () => {
                        console.log("Toggle clicked");
                        this.toggleChat(true);
                        // Add system message if it's the first time opening chat
                        if (this.elements.messages.children().length === 0) {
                            this.addSystemMessage();
                        }
                    });

                    // Minimize chat
                    this.elements.minimize.on('click', () => {
                        console.log("Minimize clicked");
                        this.toggleChat(false);
                    });

                    // Handle form submission
                    this.elements.form.on('submit', (e) => {
                        e.preventDefault();
                        console.log("Form submitted");
                        this.handleSubmit();
                    });

                    // Handle input changes
                    this.elements.input.on('input', () => {
                        console.log("Input changed");
                        this.elements.input.css('height', 'auto');
                        this.elements.input.css('height', this.elements.input[0].scrollHeight + 'px');
                    });
                },

                loadVisibilityState: async function () {
                    try {
                        const response = await fetch('/api/GeminiApi/visibility');
                        const data = await response.json();
                        if (data.success) {
                            this.toggleChat(data.isVisible);
                        }
                    } catch (error) {
                        console.error('Error loading visibility state:', error);
                    }
                },

                toggleChat: async function (show) {
                    console.log("Toggling chat visibility:", show);
                    if (show) {
                        this.elements.toggle.hide();
                        this.elements.box.show();
                    } else {
                        this.elements.box.hide();
                        this.elements.toggle.show();
                    }

                    // Save visibility state
                    try {
                        await fetch('/api/GeminiApi/toggle-visibility', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ isVisible: show })
                        });
                    } catch (error) {
                        console.error('Error saving visibility state:', error);
                    }
                },

                handleSubmit: async function () {
                    const message = this.elements.input.val().trim();
                    if (!message) return;

                    try {
                        // Disable input while processing
                        this.elements.input.prop('disabled', true);

                        // Add user message
                        this.addMessage('user', message);
                        this.elements.input.val('').css('height', 'auto');

                        // Show typing indicator
                        this.showTypingIndicator();

                        // Add context to the message
                        const contextMessage = `Bạn là một trợ lý AI chuyên về tiếng Hàn và văn hóa Hàn Quốc.
                                Hãy trả lời câu hỏi sau đây một cách chuyên nghiệp và hữu ích.
                                Nếu câu hỏi không liên quan đến tiếng Hàn, văn hóa Hàn Quốc, hoặc việc học ngôn ngữ,
                                hãy nhẹ nhàng đề nghị người dùng đặt câu hỏi liên quan đến chủ đề này.

                                Câu hỏi của người dùng: ${message}`;

                        // Send message to API
                        const response = await this.sendMessage(contextMessage);

                        // Remove typing indicator
                        this.hideTypingIndicator();

                        // Check if the response indicates out of scope
                        if (response.toLowerCase().includes("không liên quan") ||
                            response.toLowerCase().includes("không phải chủ đề")) {
                            this.addOutOfScopeMessage();
                        }

                        // Add response
                        this.addMessage('assistant', response);
                    } catch (error) {
                        console.error('Error in handleSubmit:', error);
                        this.hideTypingIndicator();
                        this.addMessage('error', 'Xin lỗi, đã có lỗi xảy ra. Vui lòng thử lại sau.');
                    } finally {
                        this.elements.input.prop('disabled', false).focus();
                    }
                },

                sendMessage: async function (message) {
                    console.log("Sending message:", message);
                    try {
                        const requestBody = { prompt: message };
                        console.log("Request body:", JSON.stringify(requestBody));

                        const response = await fetch('https://localhost:7208/api/GeminiApi/ask', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify(requestBody)
                        });

                        const responseText = await response.text();
                        console.log("Response status:", response.status);
                        console.log("Response headers:", Object.fromEntries(response.headers.entries()));
                        console.log("Response body:", responseText);

                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}, body: ${responseText}`);
                        }

                        let data;
                        try {
                            data = JSON.parse(responseText);
                        } catch (e) {
                            console.error("Error parsing response as JSON:", e);
                            throw new Error("Invalid JSON response from server");
                        }

                        console.log("Parsed API Response:", data);

                        if (!data.success) {
                            throw new Error(data.message || 'Unknown error occurred');
                        }

                        return data.message;
                    } catch (error) {
                        console.error('Error in sendMessage:', error);
                        console.error('Error stack:', error.stack);
                        throw error;
                    }
                },

                addMessage: function (role, text) {
                    const isUser = role === 'user';
                    const avatar = isUser ?
                        '<i class="fas fa-user"></i>' :
                        '<i class="fas fa-robot"></i>';
                    const sender = isUser ? 'Bạn' : 'Chat Oppa';

                    const messageHtml = `
                                <div class="chat-message ${role}">
                                    <div class="message-header">
                                        <div class="message-avatar">
                                            ${avatar}
                                        </div>
                                        <div class="message-sender">${sender}</div>
                                    </div>
                                    <div class="message-content">
                                        ${this.formatMessage(text)}
                                    </div>
                                </div>
                            `;
                    this.elements.messages.append(messageHtml);
                    this.scrollToBottom();
                },

                showTypingIndicator: function () {
                    const indicator = `
                                <div class="chat-message assistant-message typing-indicator">
                                    <div class="message-content">
                                        <div class="typing-indicator">
                                            <span></span>
                                            <span></span>
                                            <span></span>
                                        </div>
                                    </div>
                                </div>
                            `;
                    this.elements.messages.append(indicator);
                    this.scrollToBottom();
                },

                hideTypingIndicator: function () {
                    this.elements.messages.find('.typing-indicator').remove();
                },

                formatMessage: function (text) {
                    // Convert URLs to clickable links
                    const urlRegex = /(https?:\/\/[^\s]+)/g;
                    return text.replace(urlRegex, url => `<a href="${url}" target="_blank">${url}</a>`)
                        // Convert newlines to <br>
                        .replace(/\n/g, '<br>');
                },

                scrollToBottom: function () {
                    const messages = this.elements.messages[0];
                    messages.scrollTop = messages.scrollHeight;
                },

                addSystemMessage: function () {
                    const systemMessage = `
                                <div class="chat-message system">
                                    <i class="fas fa-info-circle system-message-icon"></i>
                                    Xin chào! Tôi là trợ lý AI chuyên về tiếng Hàn và văn hóa Hàn Quốc.
                                    Tôi có thể giúp bạn với:
                                    <br>• Học tiếng Hàn (ngữ pháp, từ vựng, phát âm)
                                    <br>• Luyện thi TOPIK
                                    <br>• Tìm hiểu văn hóa Hàn Quốc
                                    <br>• Giải đáp thắc mắc về Hàn Quốc
                                    <br><br>
                                    Hãy đặt câu hỏi và tôi sẽ cố gắng hỗ trợ bạn tốt nhất!
                                </div>
                            `;
                    this.elements.messages.append(systemMessage);
                    this.scrollToBottom();
                },

                addOutOfScopeMessage: function () {
                    const outOfScopeMessage = `
                                <div class="chat-message out-of-scope">
                                    <i class="fas fa-exclamation-circle out-of-scope-icon"></i>
                                    Tôi là trợ lý chuyên về tiếng Hàn và văn hóa Hàn Quốc.
                                    Bạn có thể hỏi tôi về:
                                    <br>• Học tiếng Hàn
                                    <br>• Luyện thi TOPIK
                                    <br>• Văn hóa Hàn Quốc
                                    <br>• Thông tin về Hàn Quốc
                                </div>
                            `;
                    this.elements.messages.append(outOfScopeMessage);
                    this.scrollToBottom();
                }
            };

            // Initialize chat box
            chatBox.init();
        });
    </script>



    <script>
        // Countdown Timer
        let timeLeft = @totalTimeInSeconds;
        const countdown = document.getElementById("countdown");
        const progressBar = document.getElementById("progressBar");
        const totalTime = @totalTimeInSeconds;
        const startTimeInput = document.getElementById("startTime");
        const endTimeInput = document.getElementById("endTime");

        // Function to get current time with Vietnam timezone (+7 hours)
        function getVietnamTime() {
            const now = new Date();
            now.setHours(now.getHours() + 7); // Add 7 hours for Vietnam timezone
            return now.toISOString();
        }

        // Set start time when page loads
        window.addEventListener('DOMContentLoaded', () => {
            startTimeInput.value = getVietnamTime();
        });

        function updateCountdown() {
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            countdown.innerHTML = `<i class="bi bi-clock"></i> <span>${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}</span>`;

            // Update progress bar
            const progress = ((totalTime - timeLeft) / totalTime) * 100;
            progressBar.style.width = `${progress}%`;

            // Change color when time is running out
            if (timeLeft <= 300) { // 5 minutes left
                countdown.style.backgroundColor = 'var(--warning)';
                progressBar.style.backgroundColor = 'var(--warning)';
            }
            if (timeLeft <= 60) { // 1 minute left
                countdown.style.backgroundColor = 'var(--danger)';
                progressBar.style.backgroundColor = 'var(--danger)';
            }

            if (timeLeft <= 0) {
                clearInterval(timer);
                // Set end time before submitting
                endTimeInput.value = getVietnamTime();
                Swal.fire({
                    title: '⏰ Hết thời gian!',
                    text: 'Bài làm của bạn sẽ được nộp tự động.',
                    icon: 'warning',
                    confirmButtonText: 'OK',
                    confirmButtonColor: 'var(--primary)',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    backdrop: true
                }).then(() => {
                    document.getElementById("examForm").submit();
                });
            }

            timeLeft--;
        }

        updateCountdown();
        const timer = setInterval(updateCountdown, 1000);

        // Answer selection effect
        document.querySelectorAll('.form-check-input').forEach(input => {
            input.addEventListener('change', function () {
                const answerOption = this.closest('.answer-option');
                document.querySelectorAll('.answer-option').forEach(opt => {
                    opt.classList.remove('selected');
                });
                if (this.checked) {
                    answerOption.classList.add('selected');

                    // Scroll to next question if not last question
                    if (!this.closest('.question-card').nextElementSibling?.classList.contains('text-center')) {
                        setTimeout(() => {
                            this.closest('.question-card').nextElementSibling?.scrollIntoView({
                                behavior: 'smooth',
                                block: 'start'
                            });
                        }, 300);
                    }
                }
            });
        });

        // Submit button handler
        document.getElementById("submitBtn").addEventListener("click", function () {
            // Set end time before submitting
            endTimeInput.value = getVietnamTime();

            const form = document.getElementById("examForm");
            const unanswered = document.querySelectorAll('.question-card').length -
                document.querySelectorAll('.form-check-input:checked').length;

            if (unanswered > 0) {
                Swal.fire({
                    title: 'Bạn chưa hoàn thành bài thi',
                    html: `Còn <strong>${unanswered}</strong> câu hỏi chưa được trả lời. Bạn có chắc chắn muốn nộp bài?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Nộp bài',
                    cancelButtonText: 'Tiếp tục làm',
                    confirmButtonColor: 'var(--primary)',
                    cancelButtonColor: 'var(--gray)',
                    backdrop: true,
                    focusConfirm: false,
                    focusCancel: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Clear saved progress before submitting
                        localStorage.removeItem('testProgress');
                        form.submit();
                    }
                });
            } else {
                Swal.fire({
                    title: 'Xác nhận nộp bài',
                    text: 'Bạn đã hoàn thành tất cả câu hỏi. Bạn có chắc chắn muốn nộp bài?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Nộp bài',
                    cancelButtonText: 'Kiểm tra lại',
                    confirmButtonColor: 'var(--primary)',
                    cancelButtonColor: 'var(--gray)',
                    backdrop: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Clear saved progress before submitting
                        localStorage.removeItem('testProgress');
                        form.submit();
                    }
                });
            }
        });

        // Auto-save progress (optional)
        setInterval(() => {
            // Only save if the test hasn't been submitted
            if (!document.querySelector('form.submitted')) {
                const formData = new FormData(document.getElementById("examForm"));
                localStorage.setItem('testProgress', JSON.stringify(Object.fromEntries(formData)));
            }
        }, 30000);

        // Load saved progress (optional)
        window.addEventListener('DOMContentLoaded', () => {
            // Check if the test was already submitted
            const testSetId = document.querySelector('input[name="TestSetId"]').value;
            const submittedTests = JSON.parse(localStorage.getItem('submittedTests') || '[]');
            
            if (!submittedTests.includes(testSetId)) {
                const savedProgress = localStorage.getItem('testProgress');
                if (savedProgress) {
                    const progress = JSON.parse(savedProgress);
                    for (const [name, value] of Object.entries(progress)) {
                        if (name.startsWith('Answers') && name.endsWith('SelectedAnswerId')) {
                            const input = document.querySelector(`input[name="${name}"][value="${value}"]`);
                            if (input) {
                                input.checked = true;
                                input.closest('.answer-option')?.classList.add('selected');
                            }
                        }
                    }
                }
            } else {
                // Clear any saved progress if the test was already submitted
                localStorage.removeItem('testProgress');
            }
        });

        // Add event listener for form submission
        document.getElementById("examForm").addEventListener("submit", function() {
            // Mark the test as submitted
            const testSetId = document.querySelector('input[name="TestSetId"]').value;
            const submittedTests = JSON.parse(localStorage.getItem('submittedTests') || '[]');
            if (!submittedTests.includes(testSetId)) {
                submittedTests.push(testSetId);
                localStorage.setItem('submittedTests', JSON.stringify(submittedTests));
            }
            // Clear the test progress
            localStorage.removeItem('testProgress');
            // Add a class to mark the form as submitted
            this.classList.add('submitted');
        });
    </script>
</body>
</html>