@using DATN.Application.Dtos.TestSetDtos
@{
    Layout = null;
    ViewData["Title"] = "Kết quả bài thi";
    var detailedResult = ViewBag.DetailedResult as DetailedScoringResultDto;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
        background-color: #f8f9fa; /* Slightly off-white background for a softer look */
        color: #333;
        line-height: 1.6;
    }

    .test-result-container {
        padding-top: 3rem;
        padding-bottom: 3rem;
        max-width: 900px; /* Optimized for readability */
    }

    /* Color Palette (from original, slightly refined usage) */
    .bg-theme-pink {
        background-color: #f78fb3 !important;
    }

    .bg-theme-purple {
        background-color: #a29bfe !important;
    }

    .text-theme-pink {
        color: #f78fb3 !important;
    }

    .text-theme-purple {
        color: #a29bfe !important;
    }

    /* Summary Card */
    .card-summary {
        border: none;
        border-radius: 1rem; /* Consistent rounding */
        box-shadow: 0 0.75rem 1.5rem rgba(0,0,0,0.07);
        overflow: hidden; /* Ensures header respects border-radius */
    }

    .card-summary-header {
        background: linear-gradient(135deg, #a29bfe 0%, #6c5ce7 100%); /* Purple gradient */
        color: white;
        padding: 2rem 1.5rem;
        border-bottom: none; /* Remove default border */
    }

        .card-summary-header h3 {
            font-weight: 600;
            margin-bottom: 0;
        }

        .card-summary-header .bi {
            font-size: 1.8rem;
            margin-right: 0.5rem;
            vertical-align: middle;
        }

    .card-summary-body {
        padding: 2rem;
    }

    #resultMessage {
        font-size: 1.15rem;
        font-weight: 500;
        color: #495057;
        margin-bottom: 1.5rem;
    }

    .score-display .badge {
        font-size: 1.1rem;
        padding: 0.6rem 1.2rem;
        border-radius: 50px; /* Pill shape */
        font-weight: 500;
    }

    .score-display .badge-score {
        background-color: #f78fb3; /* Pink for score */
        color: white;
    }

    .score-display .badge-total {
        background-color: #6c757d; /* Grey for total */
        color: white;
    }

    .score-display .divider-icon {
        font-size: 1.5rem;
        color: #adb5bd;
        margin: 0 0.5rem;
    }


    .progress-custom {
        height: 28px; /* Enhanced height */
        border-radius: 14px; /* Fully rounded */
        background-color: #e9ecef; /* Lighter track color */
        overflow: hidden;
        box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);
    }

    .progress-bar-custom {
        background: linear-gradient(to right, #f78fb3, #e55d87); /* Pink gradient for progress */
        border-radius: 14px;
        font-weight: 600;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
    }

    .btn-home-action {
        background: linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%); /* Cyan-Blue gradient */
        border: none;
        color: white;
        font-weight: 500;
        padding: 0.75rem 1.75rem;
        border-radius: 50px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(102, 166, 255, 0.3);
    }

        .btn-home-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(102, 166, 255, 0.4);
            background: linear-gradient(135deg, #66a6ff 0%, #89f7fe 100%);
        }

        .btn-home-action .bi {
            margin-right: 0.5rem;
            vertical-align: middle;
        }

    /* Detailed Results Section */
    .detailed-results-header {
        font-weight: 600;
        color: #343a40;
        margin-bottom: 2.5rem;
        position: relative;
        text-align: center;
    }

        .detailed-results-header::after {
            content: '';
            display: block;
            width: 80px;
            height: 4px;
            background-color: #a29bfe; /* Accent color */
            margin: 0.6rem auto 0;
            border-radius: 2px;
        }

    .question-card {
        background-color: #fff;
        border: 1px solid #e0e0e0; /* Softer border */
        border-radius: 0.75rem; /* Consistent rounding */
        margin-bottom: 2rem; /* More spacing */
        padding: 1.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

        .question-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.08);
        }

        .question-card.correct {
            border-left: 6px solid #20c997; /* Brighter Green */
            background-color: #f0fdf4; /* Very light green tint */
        }

        .question-card.incorrect {
            border-left: 6px solid #e74c3c; /* Brighter Red */
            background-color: #fdf2f2; /* Very light red tint */
        }

    .question-card-top-info {
        padding-bottom: 1rem;
        margin-bottom: 1rem;
        border-bottom: 1px dashed #eee;
    }

        .question-card-top-info h5 {
            font-weight: 600;
            color: #343a40;
        }

    .question-content p.fw-semibold {
        font-size: 1.05rem;
        color: #212529;
        line-height: 1.7;
    }

    .question-type-badge {
        font-size: 0.75rem;
        padding: 0.3rem 0.7rem;
        border-radius: 0.8rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .question-type-badge.listening {
            background-color: #a29bfe;
            color: white;
        }

        .question-type-badge.reading {
            background-color: #f78fb3;
            color: white;
        }

    .question-image {
        max-width: 100%;
        height: auto;
        border-radius: 0.5rem;
        margin: 1rem 0;
        border: 1px solid #f0f0f0;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .audio-player {
        width: 100%;
        margin: 1rem 0;
        border-radius: 25px; /* Style default player a bit */
        outline: none;
        filter: hue-rotate(10deg) saturate(1.2); /* Subtle color shift for player */
    }

    /* Answer Options */
    .answer-options {
        margin-top: 1.25rem;
    }

    .answer-option {
        padding: 0.8rem 1rem;
        border-radius: 0.5rem;
        margin-bottom: 0.6rem;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        transition: all 0.2s ease-in-out;
        display: flex;
        align-items: center;
        cursor: default; /* Not clickable in results */
    }

        .answer-option:hover { /* Subtle hover for non-interactive */
            background-color: #f1f3f5;
        }

        .answer-option .bi {
            margin-right: 0.75rem;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

    .answer-option-content {
        flex-grow: 1;
        display: flex;
        align-items: center;
    }

        .answer-option-content img {
            max-height: 80px; /* Adjusted height */
            border-radius: 0.3rem;
            margin-left: 0.5rem; /* Space if there's text before/after */
            border: 1px solid #ddd;
        }

    .answer-option.correct {
        background-color: #d1e7dd; /* BS success light */
        border-color: #badbcc;
        color: #0f5132; /* BS success dark */
    }

        .answer-option.correct .bi-check-circle-fill.text-primary {
            color: #0a58ca !important; /* Make user's correct choice distinct */
        }

        .answer-option.correct .bi-check-circle-fill.text-success {
            color: #146c43 !important; /* Darker green for correct answer icon */
        }

    .answer-option.incorrect { /* User's WRONG selected answer */
        background-color: #f8d7da; /* BS danger light */
        border-color: #f5c6cb;
        color: #842029; /* BS danger dark */
    }

        .answer-option.incorrect .bi-check-circle-fill.text-primary {
            color: #842029 !important; /* Make user's incorrect choice distinct */
        }

    /* Hint for incorrect answers */
    .incorrect-answer-hint {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        background-color: #fff3cd; /* BS warning light */
        border-left: 5px solid #ffc107; /* BS warning */
        color: #664d03; /* BS warning dark */
        border-radius: 0.3rem;
        font-size: 0.9rem;
    }

        .incorrect-answer-hint .bi {
            margin-right: 0.4rem;
            vertical-align: text-bottom;
        }

    /* Script Container Styles */
    .script-container {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .script-container:hover {
        background-color: #f1f3f5;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .script-container h6 {
        color: #6c5ce7;
        font-weight: 600;
    }

    .script-container .bi {
        margin-right: 0.5rem;
    }

    .script-text {
        color: #495057;
        line-height: 1.6;
        font-size: 0.95rem;
        white-space: pre-line;
    }

    /* SweetAlert Customizations */
    .swal2-popup {
        border-radius: 1rem !important;
    }

    .swal2-title {
        font-weight: 600 !important;
        color: #333 !important;
    }

    .swal2-html-container {
        color: #555 !important;
    }

    .swal2-confirm {
        border-radius: 50px !important;
        padding: 0.6rem 1.5rem !important;
        font-weight: 500 !important;
        /* background-color is set by JS, this is a fallback or for other buttons */
    }

    .swal2-icon.swal2-warning {
        border-color: #a29bfe !important;
        color: #a29bfe !important;
    }

</style>

<div class="container test-result-container my-5">
    <div id="resultContainer" class="d-none">
        <!-- Summary Card -->
        <div class="card card-summary mx-auto mb-5" style="max-width: 560px;">
            <div class="card-summary-header text-center py-4">
                <h3 class="mb-0"><i class="bi bi-award-fill"></i> Kết quả bài thi</h3>
            </div>
            <div class="card-summary-body text-center py-4">
                <p class="fs-5 fw-semibold" id="resultMessage"></p>

                <div class="my-4 score-display d-flex justify-content-center align-items-center">
                    <span class="badge badge-score">
                        <i class="bi bi-check-circle"></i>
                        Đúng: <span id="score"></span>
                    </span>
                    <span class="divider-icon">/</span>
                    <span class="badge badge-total">
                        <i class="bi bi-list-ol"></i>
                        Tổng số câu: <span id="total"></span>
                    </span>
                </div>

                <div class="progress progress-custom mb-4 mx-3">
                    <div class="progress-bar progress-bar-custom" id="progressBar" role="progressbar"
                         style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        0%
                    </div>
                </div>

                <a href="@Url.Action("ListTestSetForUser", "TestSet")" class="btn btn-home-action text-white fw-semibold px-4 py-2">
                    <i class="bi bi-house-heart-fill"></i> Quay về trang chủ
                </a>
            </div>
        </div>

        <!-- Detailed Results -->
        @if (detailedResult != null && detailedResult.QuestionResults.Any())
        {
            <div class="row">
                <div class="col-12">
                    <h4 class="detailed-results-header">Chi tiết bài làm</h4>
                    @foreach (var questionResultItem in detailedResult.QuestionResults.Select((value, i) => new { i, value }))
                    {
                        var question = questionResultItem.value;
                        var questionIndex = questionResultItem.i + 1;

                        <div class="question-card p-4 @(question.IsCorrect ? "correct" : "incorrect")">
                            <div class="d-flex justify-content-between align-items-center question-card-top-info">
                                <h5 class="mb-0">Câu hỏi @questionIndex</h5>
                                <span class="question-type-badge @(question.QuestionType.ToLower())">
                                    @(question.QuestionType == "Listening" ? "Nghe" : "Đọc")
                                </span>
                            </div>

                            <div class="question-content mb-3">
                                <p class="fw-semibold">@Html.Raw(question.Question)</p>

                                @if (question.QuestionType == "Reading" && !string.IsNullOrEmpty(question.QuestionImageUrl))
                                {
                                    <img src="@question.QuestionImageUrl" class="question-image img-fluid" alt="Question Image" />
                                }

                                @if (question.QuestionType == "Listening" && !string.IsNullOrEmpty(question.QuestionAudioUrl))
                                {
                                    <audio controls class="audio-player">
                                        <source src="@question.QuestionAudioUrl" type="audio/mpeg" />
                                        Trình duyệt không hỗ trợ audio.
                                    </audio>
                                }

                                @if (question.QuestionType == "Listening" && !string.IsNullOrEmpty(question.ListeningScript))
                                {
                                    <div class="script-container mt-3 p-3 bg-light rounded">
                                        <h6 class="mb-2 text-primary">
                                            <i class="bi bi-file-text"></i> Script:
                                        </h6>
                                        <p class="mb-0 script-text">@Html.Raw(@question.ListeningScript)</p>
                                    </div>
                                }
                            </div>

                            <div class="answer-options">
                                @foreach (var option in question.AnswerOptions)
                                {
                                    var isSelected = option.Id == question.UserSelectedAnswerId;
                                    var isCorrect = option.IsCorrect;
                                    var optionClass = isCorrect ? "correct" : ""; // Base class for correct
                                    if (isSelected && !isCorrect) { optionClass = "incorrect"; } // User selected wrong

                                    <div class="answer-option @optionClass">
                                        @if (isSelected)
                                        {
                                            <i class="bi bi-check-circle-fill text-primary me-2"></i>
                                        }
                                        else if (isCorrect)
                                        {
                                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-circle me-2 text-muted"></i>
                                        }
                                        <div class="answer-option-content">
                                            @if (!string.IsNullOrEmpty(option.Content) &&
                                           (option.Content.StartsWith("http") && (
                                           option.Content.EndsWith(".jpg") ||
                                           option.Content.EndsWith(".jpeg") ||
                                           option.Content.EndsWith(".png") ||
                                           option.Content.Contains("cloudinary.com")
                                           )))
                                            {
                                                <img src="@option.Content" alt="Đáp án dạng ảnh" class="img-fluid rounded" />
                                            }
                                            else
                                            {
                                                <span>@option.Content</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (!question.IsCorrect)
                            {
                                <div class="mt-3 incorrect-answer-hint">
                                    <small>
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        Bạn đã chọn sai. Đáp án đúng được đánh dấu màu xanh lá.
                                    </small>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (detailedResult != null && !detailedResult.QuestionResults.Any())
        {
            <div class="alert alert-info text-center" role="alert">
                <i class="bi bi-info-circle-fill"></i> Không có chi tiết câu hỏi nào để hiển thị cho bài thi này.
            </div>
        }
    </div>
</div>

<script>
    const score = @(ViewBag.Score != null ? ViewBag.Score.ToString() : "null");
    const total = @(ViewBag.Total != null ? ViewBag.Total.ToString() : "null");

    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = '@Html.Raw(ViewBag.Message)';
    const message = tempDiv.textContent || tempDiv.innerText || '';

    if (score !== null && total !== null && message) {
        document.getElementById('score').textContent = score;
        document.getElementById('total').textContent = total;
        document.getElementById('resultMessage').textContent = message;

        const percent = total === 0 ? 0 : Math.round((score / total) * 100);
        const progressBar = document.getElementById('progressBar');
        progressBar.style.width = percent + '%';
        progressBar.textContent = percent + '%';
        progressBar.setAttribute('aria-valuenow', percent);

        document.getElementById('resultContainer').classList.remove('d-none');
    } else {
        Swal.fire({
            icon: 'warning',
            title: 'Không có dữ liệu kết quả!',
            text: 'Không tìm thấy kết quả bài thi của bạn. Có thể bạn chưa làm bài hoặc kết quả đã không còn tồn tại.',
            confirmButtonText: 'Về trang chủ',
            confirmButtonColor: '#6c5ce7', // Darker purple for consistency
            allowOutsideClick: false,
            allowEscapeKey: false,
            customClass: {
                popup: 'swal2-popup',
                title: 'swal2-title',
                htmlContainer: 'swal2-html-container',
                confirmButton: 'swal2-confirm'
            }
        }).then(() => {
            window.location.href = '@Url.Action("Index", "Home")';
        });
    }
</script>