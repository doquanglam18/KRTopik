@using DATN.Application.Dtos.SystemLoggingDtos.Chart
@model AccessStatsViewModel

@{
    ViewData["Title"] = "Thống kê đăng nhập";
    Layout = "~/Views/Shared/_SystemAdminLayout.cshtml";
}

<h2>Thống kê đăng nhập hệ thống</h2>

<form asp-action="AccessStats" method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label for="fromDate" class="form-label">Từ ngày</label>
        <input type="date" class="form-control" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-4">
        <label for="toDate" class="form-label">Đến ngày</label>
        <input type="date" class="form-control" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Xem thống kê</button>
    </div>
</form>

@if (Model.Stats.Any())
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Tổng số lượt đăng nhập: @Model.Stats.Sum(x => x.Count)</h5>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Biểu đồ thống kê đăng nhập</h5>
        </div>
        <div class="card-body">
            <div id="chartContainer" style="position: relative; height:400px; width:100%">
                <canvas id="chart"></canvas>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const chartData = @Html.Raw(Json.Serialize(Model.ChartData));
            
            if (!chartData || chartData.length === 0) {
                document.getElementById('chartContainer').innerHTML = '<p class="text-muted">Không có dữ liệu để hiển thị biểu đồ.</p>';
                return;
            }

            try {
                const ctx = document.getElementById('chart').getContext('2d');
                const labels = chartData.map(item => new Date(item.date).toLocaleDateString('vi-VN'));
                const values = chartData.map(item => item.accessCount);

                const chart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Số lượt đăng nhập',
                            data: values,
                            backgroundColor: 'rgba(54, 162, 235, 0.7)',
                            borderColor: 'rgba(54, 162, 235, 1)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                stepSize: 1,
                                title: {
                                    display: true,
                                    text: 'Số lượt đăng nhập'
                                }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: 'Ngày'
                                }
                            }
                        }
                    }
                });
            } catch (error) {
                document.getElementById('chartContainer').innerHTML = 
                    '<p class="text-danger">Có lỗi xảy ra khi tạo biểu đồ: ' + error.message + '</p>';
            }
        });
    </script>
}
else
{
    <div class="alert alert-info">
        Không có dữ liệu đăng nhập trong khoảng thời gian đã chọn.
    </div>
}


